# Local development only. Never commit a real .env file.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=kulha
DB_USER=postgres
DB_PASSWORD=change-me-local-only

APP_WEB_BASE_URL=http://localhost:3000

# Local only: allows a fresh in-memory RSA signing key on each API restart.
# Access tokens issued before restart will stop validating; refresh after restart.
APP_SECURITY_JWT_ALLOW_EPHEMERAL_KEY=true
APP_SECURITY_JWT_ISSUER=kulha-api
APP_SECURITY_JWT_AUDIENCE=kulha-clients
APP_SECURITY_JWT_ACCESS_TTL_MINUTES=10

# Optional local Mailpit. Configure credentials only when your SMTP server requires them.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@kulha.local

# Optional: bootstrap the first admin once. Remove these values after first successful bootstrap.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Production/staging: set APP_SECURITY_JWT_ALLOW_EPHEMERAL_KEY=false and provide
# a persistent RSA key pair as Base64-encoded DER (PKCS#8 private + X.509 public).
APP_SECURITY_JWT_PRIVATE_KEY_BASE64=
APP_SECURITY_JWT_PUBLIC_KEY_BASE64=
APP_SECURITY_JWT_KEY_ID=kulha-primary
